---
import Layout from '../components/Layout.astro';
---

<Layout title="404 — 猫明之主" description="页面未找到">
  <div style="text-align:center;padding:80px 20px">
    <p style="font-size:72px;margin-bottom:16px">🐱</p>
    <h1 style="font-size:2rem;margin-bottom:12px">404 · 页面未找到</h1>
    <p style="color:var(--text-secondary);margin-bottom:24px">这只猫走丢了，但你可以回家</p>
    <a href="/" style="
      display:inline-block;padding:12px 32px;background:var(--accent);color:#000;
      border-radius:24px;font-weight:600;text-decoration:none
    ">← 回到首页</a>
  </div>
</Layout>
