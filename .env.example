# ========================================
# 猫明之主博客 — 环境变量配置模板
# ========================================
# 复制此文件为 .env 并填入真实值:
#   cp .env.example .env
# ========================================

# Firecrawl 网页抓取 API Key (必填)
BLOG_FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# 主 AI 模型 (千问) — 必填
BLOG_PRIMARY_API_KEY=your_qwen_api_key_here
BLOG_PRIMARY_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
BLOG_PRIMARY_MODEL=qwen-plus

# 备用 AI 模型 (DeepSeek) — 可选，主模型失败时自动切换
BLOG_BACKUP_API_KEY=your_deepseek_api_key_here
BLOG_BACKUP_API_BASE=https://api.deepseek.com
BLOG_BACKUP_MODEL=deepseek-chat

# 内容富化开关 (true=Firecrawl抓取+AI总结, false=仅RSS摘要)
BLOG_ENRICH_ENABLED=true

# AI 总结目标字数
BLOG_TARGET_WORDS=700

# Firecrawl 抓取超时秒数
BLOG_SCRAPE_TIMEOUT=30

# Embedding 模型 (用于 RAG 语义搜索/去重，复用 DashScope API)
BLOG_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
BLOG_EMBEDDING_MODEL=text-embedding-v1
